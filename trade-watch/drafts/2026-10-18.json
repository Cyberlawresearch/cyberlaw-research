    {
      "id": "tw-vietnam-steel-injury",
      "j": "中国台湾地区",
      "agency": "经济事务主管部门贸易救济委员会",
      "event": "2026-10-16",
      "dateNote": "10月16日公告；初步认定于10月12日作出",
      "title": "台湾地区公布越南冷轧不锈钢初步损害肯定认定，倾销调查继续",
      "status": "初步产业损害认定，尚无最终征税决定",
      "fact": "10月16日官方公告披露，贸易救济委员会已于10月12日认定，越南部分冷轧不锈钢产品被指低于正常价值进口，对本地产业造成实质损害存在合理迹象。该结论属于初步产业损害门槛判断，后续仍由财政主管部门继续调查倾销及相关事项，不能将初步损害认定解释为最终税率。",
      "scope": "越南冷轧不锈钢板材对台出口及相关钢材加工、采购链。",
      "impact": "中国企业经越南加工供货时，应保留实际生产工序、原料投入、原产地和物流证据，并与买方明确后续临时措施或最终税款的承担方式。仅经第三地转运不能替代真实原产地判断。",
      "deadline": "倾销初步认定原则上在收到损害认定通知次日起70日内作出，可依法延期；公开版损害报告预计11月12日后提供。",
      "sources": [
        [
          "https://www.trade.gov.tw/english/Pages/detail.aspx?nodeID=86&pid=821303",
          "10月16日初步损害认定官方公告"
        ]
      ],
      "verified": true,
      "source": "https://www.trade.gov.tw/english/Pages/detail.aspx?nodeID=86&pid=821303",
      "jurisdiction": "中国台湾地区",
      "event_date": "2026-10-16",
      "deduplication": "已与main最近7期及本次四期交叉核对，无同一新增动作重复"
    }
