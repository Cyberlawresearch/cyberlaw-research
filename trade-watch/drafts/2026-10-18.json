    {
      "id": "us-semiconductor-337-amend",
      "j": "美国",
      "agency": "USITC",
      "event": "2026-10-16",
      "dateNote": "10月16日公报公布；决定于10月13日作出",
      "title": "美国337-TA-1500半导体案扩大专利主张范围，尚无进口排除决定",
      "status": "投诉及调查通知修订，不是侵权终裁",
      "fact": "10月16日《联邦公报》公布，美国国际贸易委员会不复审行政法官第8号初裁，允许GlobalFoundries在337-TA-1500案中增加美国专利8,507,983的从属权利要求8—12及19。被调查方包括Tower在以色列、日本、意大利及美国的相关企业。委员会于10月13日作出决定；本次仅扩大审理的专利主张，没有认定侵权，也未签发排除令。",
      "scope": "涉Tower晶圆制造服务、相关半导体器件及包含该器件的产品进口。",
      "impact": "采购相关晶圆或芯片的企业应核对涉案产品和美国进口链条，向供应商确认新增权利要求对应的技术方案及应诉安排，并在供货合同中明确知识产权争议的通知和替代供应机制。",
      "deadline": "本次公告无统一企业答卷新期限，诉讼日程应以案件具体命令为准。",
      "sources": [
        [
          "https://www.govinfo.gov/content/pkg/FR-2026-10-16/html/2026-21124.htm",
          "美国《联邦公报》2026-21124号公告"
        ]
      ],
      "verified": true,
      "source": "https://www.govinfo.gov/content/pkg/FR-2026-10-16/html/2026-21124.htm",
      "jurisdiction": "美国",
      "event_date": "2026-10-16",
      "deduplication": "已与main最近7期及本次四期交叉核对，无同一新增动作重复"
    },
    {
      "id": "eu-furfuryl-ad",
      "j": "欧盟",
      "agency": "欧盟委员会、香港工业贸易署",
      "event": "2026-10-16",
      "title": "欧盟对中国糠醇启动反倾销调查，涉案税号和应诉范围需逐项核对",
      "status": "反倾销调查立案，尚非征税决定",
      "fact": "欧盟委员会10月16日发布C/2026/5408号公告，对中国大陆原产糠醇启动反倾销调查。香港工业贸易署同日第904/2026号通告确认立案及涉案产品信息，并提供欧盟公告原文入口。产品CAS号为98-00-0，CN编码为ex 2932 13 00，TARIC编码为2932 13 00 30。立案意味着调查启动，不代表已经确定倾销幅度或新增反倾销税。",
      "scope": "中国糠醇生产商、对欧出口商、欧盟化工进口商及下游采购企业。",
      "impact": "应按实际化学品成分及产品定义判断是否涉案，保存欧盟销售、成本和原产地资料，并及时核对立案公告中的抽样及问卷安排。税号用于识别产品，不能单凭相近税号判断全部商品均受调查。",
      "deadline": "10月16日立案；具体提交期限须依欧盟立案公告及个别通知计算。",
      "sources": [
        [
          "https://www.tid.gov.hk/en/tradecircular/2026/ci9042026.html",
          "香港工业贸易署第904/2026号官方通告及欧盟原文入口"
        ]
      ],
      "verified": true,
      "source": "https://www.tid.gov.hk/en/tradecircular/2026/ci9042026.html",
      "jurisdiction": "欧盟",
      "event_date": "2026-10-16",
      "deduplication": "已与main最近7期及本次四期交叉核对，无同一新增动作重复"
    },
    {
      "id": "uk-sanctions-variations",
      "j": "英国",
      "agency": "FCDO",
      "event": "2026-10-16",
      "title": "英国变更三项反恐制裁列名资料，既有冻结及武器禁运继续适用",
      "status": "既有列名资料变更，非新增或解除制裁",
      "fact": "英国外交部门10月16日变更ISIL及基地组织制裁机制下三项既有列名，涉及巴基斯坦塔利班、Mounir El Motassadeq及Noor Wali Mehsud。通知明确，三项列名仍受各自列示制裁约束，其中包括资产冻结、武器禁运及适用于有关个人的旅行禁令。企业应区分身份资料更新与新增列名，不能据此判断相关交易已经解禁。",
      "scope": "有英国制裁连接点的跨境付款、贸易融资、物流服务及交易方筛查。",
      "impact": "筛查系统应同步更新组织别名、地址及个人识别资料，复核已有客户和付款命中记录。涉及资产冻结的交易，应依据适用例外或许可证判断能否处理，不能仅凭名称变化解除拦截。",
      "deadline": "10月16日名单资料更新；公告未设置新的普遍交易宽限期。",
      "sources": [
        [
          "https://assets.publishing.service.gov.uk/media/6ad1ebc9e5db84746b4796e9/Sanctions_Notice__ISIL__Da_esh____Al-Qaeda__16_October_2026.pdf",
          "英国FCDO 10月16日制裁通知"
        ]
      ],
      "verified": true,
      "source": "https://assets.publishing.service.gov.uk/media/6ad1ebc9e5db84746b4796e9/Sanctions_Notice__ISIL__Da_esh____Al-Qaeda__16_October_2026.pdf",
      "jurisdiction": "英国",
      "event_date": "2026-10-16",
      "deduplication": "已与main最近7期及本次四期交叉核对，无同一新增动作重复"
